generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id              String      @id @default(cuid())
  title           String
  description     String
  price           Int
  category        String
  image           String
  stock           Int         @default(0)
  fabric          String?
  careInstructions String?
  sizes           String      @default("S,M,L,XL,XXL")
  occasion        String?     @default("Festive Celebrations")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  totalAmount     Int
  status          String      @default("PENDING")
  stripeSessionId String?     @unique
  createdAt       DateTime    @default(now())
  items           OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Int
  size      String?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}
